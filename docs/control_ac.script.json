{
    "alias": "Control AC",
    "description": "Turn any air conditioner on or off, set its mode (cool, heat, fan_only, dry, heat_cool), and optionally its target temperature, in one call. The ACs are one-way infrared units with no state feedback, so ALWAYS use this script when the user wants an AC running in a mode or at a temperature; it powers the unit on in the requested mode before applying the temperature. Pick the ac option that matches the room or person the user means; 'my bedroom' means Elijah's bedroom.",
    "fields": {
        "ac": {
            "description": "Which AC to control.",
            "required": true,
            "selector": {
                "select": {
                    "options": [
                        "living room",
                        "elijah bedroom",
                        "ram bedroom"
                    ]
                }
            }
        },
        "hvac_mode": {
            "description": "Mode to put the AC in. Use cool for cooling, off to turn it off.",
            "required": true,
            "selector": {
                "select": {
                    "options": [
                        "off",
                        "cool",
                        "heat",
                        "fan_only",
                        "dry",
                        "heat_cool"
                    ]
                }
            }
        },
        "temperature": {
            "description": "Target temperature in Celsius, 16-30. Optional.",
            "required": false,
            "selector": {
                "number": {
                    "min": 16,
                    "max": 30,
                    "step": 1
                }
            }
        }
    },
    "sequence": [
        {
            "variables": {
                "entity": "{{ {'living room': 'climate.living_room_ac', 'elijah bedroom': 'climate.elijah_s_bedroom_ac', 'ram bedroom': 'climate.ram_s_bedroom_ac'}[ac] }}"
            }
        },
        {
            "action": "climate.set_hvac_mode",
            "target": {
                "entity_id": "{{ entity }}"
            },
            "data": {
                "hvac_mode": "{{ hvac_mode }}"
            }
        },
        {
            "if": [
                {
                    "condition": "template",
                    "value_template": "{{ temperature is defined and temperature is not none and hvac_mode != 'off' }}"
                }
            ],
            "then": [
                {
                    "delay": {
                        "seconds": 1
                    }
                },
                {
                    "action": "climate.set_temperature",
                    "target": {
                        "entity_id": "{{ entity }}"
                    },
                    "data": {
                        "temperature": "{{ temperature }}"
                    }
                }
            ]
        }
    ],
    "mode": "parallel"
}
